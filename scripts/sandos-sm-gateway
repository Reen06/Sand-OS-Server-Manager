#!/usr/bin/env bash
# Re-export this node's mesh NAS mount over NFS, for nodes that cannot mount the
# cluster themselves.
#
# Exactly one kind of node needs this: a machine running Docker Desktop, whose
# containers live in a separate VM from the filesystem the Server Manager sees.
# A FUSE mount there is invisible to its containers — it looks correct from a
# shell and every app reports an empty NAS.
#
# Driven by the Hub, which is the only thing that can see which nodes need a
# gateway and which are capable of being one. Nothing here decides policy; it
# applies a client list and refuses anything malformed.
set -euo pipefail

MESH_MOUNT="${SM_MESH_NAS_MOUNT:-/mnt/sandos-nas}"
EXPORTS_FILE=/etc/exports.d/sandos-mesh-gateway.exports

die() { echo "sandos-sm-gateway: $*" >&2; exit 1; }

_check_ready() {
  command -v exportfs >/dev/null || die "nfs-kernel-server is not installed on this node"
  mountpoint -q "$MESH_MOUNT" || die "$MESH_MOUNT is not mounted — this node cannot gateway what it cannot see"
}

cmd_status() {
  local clients=""
  [[ -f "$EXPORTS_FILE" ]] && clients=$(grep -oE '[0-9]{1,3}(\.[0-9]{1,3}){3}' "$EXPORTS_FILE" | sort -u | tr '\n' ' ')
  printf '{"mount":"%s","mounted":%s,"serving":"%s"}\n' \
    "$MESH_MOUNT" \
    "$(mountpoint -q "$MESH_MOUNT" && echo true || echo false)" \
    "${clients% }"
}

cmd_serve() {
  # Full client list every time, not incremental. An export that lingers because
  # nobody removed it is a standing grant to a machine the Hub no longer lists —
  # rewriting the file wholesale means the Hub's view is always the whole truth.
  _check_ready
  local clients=("$@")
  mkdir -p "$(dirname "$EXPORTS_FILE")"
  : > "$EXPORTS_FILE"
  {
    echo "# Generated by sandos-sm-gateway. Do not edit — rewritten on every sync."
    echo "# Serves the mesh NAS to nodes that cannot mount the cluster directly."
  } >> "$EXPORTS_FILE"
  local n=0
  for c in "${clients[@]}"; do
    [[ "$c" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "not an IPv4 address: $c"
    # crossmnt: the mesh mount is a different filesystem from the directory it
    # sits in, and without this a client follows into it and sees nothing.
    # all_squash to one identity: the cluster stores no per-client ownership, so
    # pretending otherwise across this hop would invent permissions.
    printf '%s %s(rw,sync,fsid=0,crossmnt,no_subtree_check,all_squash,anonuid=1000,anongid=1000,insecure)\n' \
      "$MESH_MOUNT" "$c" >> "$EXPORTS_FILE"
    n=$((n+1))
  done
  if (( n == 0 )); then
    rm -f "$EXPORTS_FILE"
  fi
  exportfs -ra
  systemctl is-active --quiet nfs-kernel-server || systemctl enable --now nfs-kernel-server >/dev/null 2>&1
  cmd_status
}

cmd_stop() {
  rm -f "$EXPORTS_FILE"
  exportfs -ra 2>/dev/null || true
  cmd_status
}

case "${1:-}" in
  status) cmd_status ;;
  serve)  shift; cmd_serve "$@" ;;
  stop)   cmd_stop ;;
  *) die "usage: sandos-sm-gateway {status|serve <client-ip>...|stop}" ;;
esac
