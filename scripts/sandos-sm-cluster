#!/usr/bin/env bash
# Configure this node's SeaweedFS volume server: which directories it stores
# chunks in, and how much each may hold.
#
# A server can have several drives, and they are rarely equal — a fast SSD you
# want heavily used, a big slow disk for bulk, a USB stick you can spare 50GB
# from. SeaweedFS takes `-dir a,b,c` with a matching `-max 100,500,50`, so the
# per-drive split is expressible; this writes that configuration.
#
# Driven by the Hub. Nothing here decides policy: it applies a list, validates
# it, and refuses anything malformed rather than writing a unit that will not
# start.
set -euo pipefail

UNIT=/etc/systemd/system/seaweedfs-volume.service

die() { echo "sandos-sm-cluster: $*" >&2; exit 1; }

# Which mesh this node joins. Read from the node's own environment file, which
# the installer writes from what it discovered on the network it was installed
# to — never a literal here.
#
# This used to default to one specific machine's address. That address belonged
# to the mesh this script was written on, so any OTHER deployment inherited it:
# a node installed elsewhere would quietly try to join a cluster it has never
# heard of, on a network it may not even be able to reach, and report a volume
# server that never registers. A wrong default is worse than none, because the
# failure looks like a network problem rather than a configuration one.
_seaweed_master() {
  local m="${SM_SEAWEED_MASTER:-}"
  if [ -z "$m" ] && [ -r /etc/sandos-server-manager.env ]; then
    m=$(sed -n 's/^[[:space:]]*SM_SEAWEED_MASTER=//p' /etc/sandos-server-manager.env \
        | tail -1 | tr -d '\042\047')
  fi
  if [ -z "$m" ] && [ -r /etc/sandos-server-manager.env ]; then
    # Fall back to the NAS host this node was pointed at, which is the machine
    # running the mesh's master, on its standard port.
    local h
    h=$(sed -n 's/^[[:space:]]*SM_NAS_HOST=//p' /etc/sandos-server-manager.env \
        | tail -1 | tr -d '\042\047')
    [ -n "$h" ] && m="${h}:9333"
  fi
  [ -n "$m" ] || die "no SeaweedFS master configured — set SM_SEAWEED_MASTER (or SM_NAS_HOST) in /etc/sandos-server-manager.env"
  echo "$m"
}
MASTER="$(_seaweed_master)"

_node_ip() {
  ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src") print $(i+1); exit}'
}

# Rack identity decides replication placement: "a copy on another rack" means a
# copy on another machine. Lowercased so re-applying cannot silently RENAME a
# rack that was registered differently-cased — the cluster would treat the old
# and new names as two places, and a rule asking for two racks could be
# satisfied by one machine wearing both names.
_rack() { hostname | tr '[:upper:]' '[:lower:]'; }

# How this node runs its volume server. Not every node runs it the same way: a
# systemd unit on machines where SeaweedFS was installed natively, and a Docker
# container where it was not. Writing a unit on a containerised node would start
# a SECOND volume server fighting the first for the same port, so the mode is
# detected rather than assumed.
CONTAINER=seaweedfs-volume

# Pinned, and deliberately the STANDARD build. SeaweedFS also publishes a
# `large_disk` variant, which panics in the FUSE write path on this fleet —
# a node built that way crashed over a hundred times a day. Overridable, but
# not casually.
SEAWEED_IMAGE="${SM_SEAWEED_IMAGE:-chrislusf/seaweedfs:4.40}"
# Topology label, not an address: replication rules are written in terms of
# racks within a data centre, and every node in one mesh must agree on the name
# or the cluster believes it spans places it does not.
SEAWEED_DC="${SM_SEAWEED_DC:-home}"
SEAWEED_PORT="${SM_SEAWEED_PORT:-8080}"

# How this node runs its volume server.
#
# Docker is preferred wherever Docker exists, because it is the same on every
# machine: no `weed` binary to install at a matching version, no service user,
# no unit to keep in step. The native path remains for nodes with no Docker,
# and — importantly — for a node ALREADY running the systemd unit, which must
# not be silently migrated out from under a working cluster member.
_mode() {
  if systemctl is-active --quiet "$CONTAINER" 2>/dev/null; then
    echo systemd
  elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    echo docker
  elif [ -f "$UNIT" ]; then
    echo systemd
  else
    echo systemd
  fi
}

# The container sees its drives at /data0, /data1 … while the Hub and the person
# using it think in HOST paths. Both directions are needed: status reports host
# paths (the only ones meaningful outside the container), apply maps them back.
_docker_hostdirs() {
  docker inspect "$CONTAINER" --format \
    '{{range .Mounts}}{{if eq .Type "bind"}}{{.Destination}}={{.Source}}
{{end}}{{end}}' 2>/dev/null
}

_docker_arg() {  # _docker_arg -max  ->  the value, or empty
  docker inspect "$CONTAINER" --format '{{range .Config.Cmd}}{{println .}}{{end}}' 2>/dev/null \
    | sed -n "s/^$1=//p" | head -1
}

cmd_status_docker() {
  local running cdirs maxes dirs="" first=1 usage="["
  running=$([ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = true ] \
            && echo true || echo false)
  cdirs=$(_docker_arg -dir); maxes=$(_docker_arg -max)
  local map; map=$(_docker_hostdirs)
  IFS=',' read -ra _cd <<< "${cdirs:-}"
  for cd in "${_cd[@]}"; do
    [[ -z "$cd" ]] && continue
    # Translate each container path back to the host path it is bound from. A
    # directory with no bind is reported as-is rather than hidden — it would be
    # container-local storage, which is a real problem worth seeing.
    local host; host=$(printf '%s\n' "$map" | sed -n "s|^${cd}=||p" | head -1)
    host="${host:-$cd}"
    dirs+="${dirs:+,}$host"
    local used avail vols
    used=$(df -B1 --output=used "$host" 2>/dev/null | tail -1 | tr -d ' ')
    avail=$(df -B1 --output=avail "$host" 2>/dev/null | tail -1 | tr -d ' ')
    vols=$(find "$host" -maxdepth 1 -name '*.dat' 2>/dev/null | wc -l)
    (( first )) || usage+=","
    first=0
    usage+=$(printf '{"dir":"%s","used_bytes":%s,"avail_bytes":%s,"volumes":%s}' \
             "$host" "${used:-0}" "${avail:-0}" "$vols")
  done
  usage+="]"
  printf '{"running":%s,"dirs":"%s","max":"%s","mode":"docker","usage":%s}\n' \
    "$running" "$dirs" "${maxes:-}" "$usage"
}

cmd_apply_docker() {
  # $1 = comma-joined HOST dirs, $2 = comma-joined maxes
  local hostdirs="$1" maxes="$2"
  local image mserver ip port dc rack restart

  if docker inspect "$CONTAINER" >/dev/null 2>&1; then
    # Existing member: carry its identity forward untouched. Re-deriving these
    # could RENAME the node's rack, and the cluster would then treat one machine
    # as two places — a rule asking for copies on two racks could be satisfied
    # by this box alone, which is the opposite of what it asks for.
    image=$(docker inspect -f '{{.Config.Image}}' "$CONTAINER")
    mserver=$(_docker_arg -mserver); ip=$(_docker_arg -ip); port=$(_docker_arg -port)
    dc=$(_docker_arg -dataCenter); rack=$(_docker_arg -rack)
    restart=$(docker inspect -f '{{.HostConfig.RestartPolicy.Name}}' "$CONTAINER")
    [[ -n "$image" && -n "$mserver" ]] || die "could not read the existing container's settings"
  else
    # First contribution from this node: no container to copy settings from, so
    # derive them. Without this branch a node that had never stored anything
    # fell through to the native path and needed a matching `weed` binary and a
    # service user that a fresh machine does not have — so "contribute storage"
    # reported success and started nothing.
    image="$SEAWEED_IMAGE"; mserver="$MASTER"
    ip=$(_node_ip); port="$SEAWEED_PORT"
    dc="$SEAWEED_DC"; rack=$(_rack); restart="unless-stopped"
    [[ -n "$ip" ]] || die "could not determine this node's address"
    [[ -n "$mserver" ]] || die "no SeaweedFS master configured"
    # Refuse to start a second server fighting an existing one for the port.
    if pgrep -f 'weed .*volume' >/dev/null 2>&1; then
      die "a volume server is already running on this node outside Docker — \
refusing to start a second one that would contend for port ${port}"
    fi
    docker image inspect "$image" >/dev/null 2>&1 || docker pull "$image" >/dev/null
  fi

  # Keep the rack EXACTLY as it is. A rack rename would make the cluster treat
  # this machine as a new place, and a rule asking for copies on two racks could
  # then be satisfied by one machine wearing both names.
  # The first drive goes to /data specifically, because the image DECLARES
  # /data as a volume: leave it unbound and Docker invents an anonymous volume
  # there on every run, quietly accumulating one per change. Extra drives take
  # /data1, /data2 … which are not declared and so create nothing.
  local mounts=() cdirs="" i=0
  IFS=',' read -ra _hd <<< "$hostdirs"
  for h in "${_hd[@]}"; do
    local cpath="/data"; (( i > 0 )) && cpath="/data$i"
    mounts+=(-v "$h:$cpath")
    cdirs+="${cdirs:+,}$cpath"
    i=$((i+1))
  done

  # Removing the container does NOT touch the data: every drive is a bind mount
  # living on the host. What is lost is the few seconds the volume server is
  # down, which is why the Hub says so before doing it.
  # -v so any anonymous volume the previous container created goes with it.
  # Bind mounts are unaffected: the drives themselves are never touched.
  # `|| true` for the bootstrap case: there is no container to remove the first
  # time, and under `set -e` that non-zero exit would abort before creating one.
  docker rm -f -v "$CONTAINER" >/dev/null 2>&1 || true
  docker run -d --name "$CONTAINER" --network host \
    --restart "${restart:-unless-stopped}" "${mounts[@]}" "$image" \
    volume -mserver="$mserver" -ip="$ip" -port="$port" \
    -dir="$cdirs" -max="$maxes" -dataCenter="$dc" -rack="$rack" >/dev/null
  sleep 3
  cmd_status_docker
}

cmd_status() {
  if [[ "$(_mode)" == docker ]]; then cmd_status_docker; return; fi
  local dirs="" maxes="" running=false
  if [[ -f "$UNIT" ]]; then
    dirs=$(grep -oE '\-dir=[^ ]+' "$UNIT" | head -1 | cut -d= -f2-)
    maxes=$(grep -oE '\-max=[^ ]+' "$UNIT" | head -1 | cut -d= -f2-)
  fi
  systemctl is-active --quiet seaweedfs-volume && running=true
  # Per-directory usage, so the Hub can warn before someone shrinks a drive
  # below what is already stored on it.
  local usage="["
  IFS=',' read -ra _d <<< "${dirs:-}"
  local first=1
  for d in "${_d[@]}"; do
    [[ -z "$d" ]] && continue
    local used avail vols
    used=$(df -B1 --output=used "$d" 2>/dev/null | tail -1 | tr -d ' ')
    avail=$(df -B1 --output=avail "$d" 2>/dev/null | tail -1 | tr -d ' ')
    vols=$(find "$d" -maxdepth 1 -name '*.dat' 2>/dev/null | wc -l)
    (( first )) || usage+=","
    first=0
    usage+=$(printf '{"dir":"%s","used_bytes":%s,"avail_bytes":%s,"volumes":%s}' \
             "$d" "${used:-0}" "${avail:-0}" "$vols")
  done
  usage+="]"
  printf '{"running":%s,"dirs":"%s","max":"%s","usage":%s}\n' \
    "$running" "${dirs:-}" "${maxes:-}" "$usage"
}

cmd_apply() {
  # apply <dir>:<max> [<dir>:<max> ...]
  (( $# > 0 )) || die "no directories given"
  local dirs="" maxes=""
  for spec in "$@"; do
    local d="${spec%:*}" m="${spec##*:}"
    [[ "$d" =~ ^/[A-Za-z0-9._/-]*$ ]] || die "not a plain absolute path: $d"
    [[ "$m" =~ ^[0-9]+$ ]] || die "max must be a whole number, got: $m for $d"
    mountpoint -q "$d" 2>/dev/null || [[ -d "$d" ]] || die "no such directory: $d"
    mkdir -p "$d"
    # A directory that holds volumes must keep a limit that can contain them.
    # Lowering below what is stored does not delete anything, but it does mean
    # SeaweedFS stops placing there — worth refusing silently doing it.
    local have; have=$(find "$d" -maxdepth 1 -name '*.dat' 2>/dev/null | wc -l)
    if (( m > 0 && have > m )); then
      die "$d already holds $have volumes, cannot set its limit to $m — move them off first"
    fi
    dirs+="${dirs:+,}$d"
    maxes+="${maxes:+,}$m"
  done

  if [[ "$(_mode)" == docker ]]; then
    cmd_apply_docker "$dirs" "$maxes"
    return
  fi

  local ip rack memmax memhigh
  ip=$(_node_ip); rack=$(_rack)
  [[ -n "$ip" ]] || die "could not determine this node's address"
  # Sized from the machine rather than fixed: these nodes range from a 4GB Pi to
  # an 11GB mini PC, and one number would either strangle the small ones or fail
  # to protect the large ones.
  local totalkb; totalkb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
  memmax="$(( totalkb * 60 / 100 / 1024 ))M"
  memhigh="$(( totalkb * 45 / 100 / 1024 ))M"

  install -m 0644 /dev/stdin "$UNIT" <<UNITEOF
[Unit]
Description=SeaweedFS volume server (this machine's contribution to the mesh NAS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
# One entry per contributing drive. Generated by sandos-sm-cluster from the
# per-drive allocation set in the Hub — do not edit by hand, it is rewritten.
ExecStart=/usr/local/bin/weed volume -mserver=${MASTER} -ip=${ip} -port=8080 \\
  -dir=${dirs} -max=${maxes} -dataCenter=home -rack=${rack}
Restart=on-failure
RestartSec=5
# A volume server buffers incoming chunks in memory while it replicates them to
# the other copies. If a replica is slow to accept — an SD-backed node, say —
# that buffer grows with no bound of its own, and the process can consume the
# whole machine and be OOM-killed. Observed: 10.9 GB RSS on an 11 GB host,
# killed mid-write, taking the node's whole contribution offline until systemd
# restarted it.
#
# Capping it converts that failure into a survivable one: writes slow down or
# fail individually instead of the server dying. 60%% of RAM leaves room for
# everything else the machine is doing.
MemoryMax=${memmax}
MemoryHigh=${memhigh}

[Install]
WantedBy=multi-user.target
UNITEOF

  # Ownership matters: the service runs unprivileged, so every contributing
  # directory has to be writable by it or the volume server starts and then
  # fails on first placement, which looks like a cluster problem rather than a
  # permissions one.
  id -u seaweedfs >/dev/null 2>&1 || useradd -r -s /usr/sbin/nologin seaweedfs
  IFS=',' read -ra _dd <<< "$dirs"
  for d in "${_dd[@]}"; do chown seaweedfs:seaweedfs "$d" 2>/dev/null || true; done

  # Refuse to add a second volume server. If one is already running outside both
  # the unit and a container, starting ours would contend for the same port and
  # the failure would look like a cluster fault rather than two servers.
  if pgrep -f 'weed .*volume' >/dev/null 2>&1 \
     && ! systemctl is-active --quiet seaweedfs-volume; then
    die "a volume server is already running on this node outside systemd — \
refusing to start a second one that would fight it for port 8080"
  fi

  systemctl daemon-reload
  systemctl enable --now seaweedfs-volume >/dev/null 2>&1 || true
  systemctl restart seaweedfs-volume
  sleep 3
  cmd_status
}

# Start contributing with no numbers supplied, choosing where from the machine
# itself. The Hub cannot make this choice: which disks exist, how big they are
# and which hold POSIX filesystems are facts about the node, and the obvious
# Hub-side default — "the NAS root" — is frequently the SYSTEM disk. On one real
# node that was 51GB free while an idle 1000GB data drive sat beside it.
#
# Deliberately conservative: it picks a directory, not a size. `max=0` means
# unlimited-by-count, and the real per-drive caps are set afterwards from the
# storage page, which is where someone can see the whole fleet at once.
cmd_bootstrap() {
  local best="" bestavail=0 mp avail fstype
  while read -r mp fstype avail; do
    case "$fstype" in ext2|ext3|ext4|xfs|btrfs) ;; *) continue ;; esac
    # Skip pseudo/boot/system mounts: contributing from the disk the OS runs on
    # competes with the OS for space, and filling it is a much worse failure
    # than storing nothing.
    case "$mp" in /|/boot|/boot/*|/var|/var/*|/usr|/usr/*) continue ;; esac
    (( avail > bestavail )) && { bestavail=$avail; best=$mp; }
  done < <(df -B1 --output=target,fstype,avail 2>/dev/null | tail -n +2 \
           | awk 'NF>=3 {print $1, $2, $3}')

  if [[ -z "$best" ]]; then
    # Nothing dedicated — fall back to the configured NAS root, which at least
    # exists. Reported plainly rather than silently, because a node contributing
    # from its system disk is worth knowing about.
    best=$(sed -n 's/^[[:space:]]*SM_NAS_ROOT=//p' /etc/sandos-server-manager.env 2>/dev/null \
           | tail -1 | tr -d '\042\047')
    best="${best:-$HOME/sandos-nas}"
    echo "sandos-sm-cluster: no dedicated data filesystem found; using $best" >&2
  fi
  mkdir -p "$best/.cluster"
  cmd_apply "$best/.cluster:0"
}

case "${1:-}" in
  status)    cmd_status ;;
  apply)     shift; cmd_apply "$@" ;;
  bootstrap) cmd_bootstrap ;;
  *) die "usage: sandos-sm-cluster {status|apply <dir>:<max> [<dir>:<max>...]|bootstrap}" ;;
esac
