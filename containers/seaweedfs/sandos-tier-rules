#!/usr/bin/env bash
# Apply tier policy as filer path rules.
#
# Prefix rules cannot express "*/Bulk", so each user's tier folders get their
# own rule. That is fine for a household and is generated, not hand-written —
# adding a user re-runs this.
#
# replication is xyz = extra copies in (other datacentre, other rack, same rack).
# A "rack" here is one physical machine, so 010 means a second copy on a
# different server. With two volume servers today, two copies is the ceiling;
# Tier 3 becomes 020 once a third machine joins, which is why it is generated
# rather than fixed.
set -euo pipefail
MASTER=10.0.0.177:9333
NASROOT=/nas
USERS="${*:-braeden admin}"

TIER2_REPL=010     # Protected: a second copy on another machine
TIER1_REPL=000     # Bulk: one copy, may be lost — that is the deal
TIER3_REPL=010     # Critical: max meaningful with 2 machines; 020 with 3

{
  echo "fs.configure -locationPrefix=${NASROOT}/users/ -replication=${TIER2_REPL} -apply"
  echo "fs.configure -locationPrefix=${NASROOT}/shared/ -replication=${TIER2_REPL} -apply"
  for u in $USERS; do
    echo "fs.configure -locationPrefix=${NASROOT}/users/${u}/Bulk/ -replication=${TIER1_REPL} -apply"
    echo "fs.configure -locationPrefix=${NASROOT}/users/${u}/Critical/ -replication=${TIER3_REPL} -apply"
  done
  echo "fs.configure"
} | weed shell -master="$MASTER"
